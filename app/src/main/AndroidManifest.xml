<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前台服务用于降低 HyperOS 冻结进程的概率；不涉及任何网络能力 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      申请电池优化豁免（Doze 白名单）。
      定制 ROM 的省电策略会把应用置于「受限」状态，效果等同于 force-stop，
      而无障碍权限会因此被系统剥离 —— 这才是「设置一次之后过阵子又失效」的真正原因。
      这不是网络权限，只是免除省电限制。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".AfuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AfuLedger">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          自动记账：只声明无障碍服务，不申请 INTERNET / SYSTEM_ALERT_WINDOW / READ_SMS。
          BIND_ACCESSIBILITY_SERVICE 由系统在用户授权后绑定，不是运行时权限。
        -->
        <service
            android:name=".auto.AutoLedgerAccessibilityService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:label="@string/auto_ledger_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the on-device payment recognition accessibility service responsive on ROMs that freeze background processes; no network use" />
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_ledger_service" />
        </service>
    </application>

</manifest>
